#!/usr/bin/env bash
#
# Quickstart — install → lint → build → unit → integration → deploy
# for the supervictor workspace (cli, common, edge, endpoint).
#
set -e
set -o nounset
set -o pipefail

export ENV="${ENV:-dev}"

# Load stage config (CERT_PATH, HOST, SSID, ... consumed at compile time by edge)
if [[ -f ".env.${ENV}" ]]; then
    set -a
    . ".env.${ENV}"
    set +a
fi

[[ "${TRACE:-0}" == "1" ]] && set -o xtrace

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
command_exists() { command -v "$1" >/dev/null 2>&1; }

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$REPO_ROOT"
HOST_TARGET="$(rustc -vV | sed -n 's/^host: //p')"

help_function() {
    cat <<EOF

Usage: $(basename "$0") [command] [-h] [-t]

Commands:
  install       Check toolchain (nightly + rust-src for embedded) and fetch deps
  lint          cargo fmt --check + clippy --all-targets -D warnings
  build         Build workspace + edge embedded (riscv32) + edge desktop
  unit          Run the full workspace test suite on the host
  integration   SAM-local roundtrip tests (needs SAM_LOCAL_URL) + staging smoke
  deploy        Deploy the staging endpoint (scripts/deploy-staging.sh)
  help          This message

Options:
  -h, --help    Display this help message and exit
  -t, --test    Run everything: lint -> build -> unit -> integration

No arguments runs lint -> build -> unit.

Env: ENV selects .env.<stage> (default: dev). TRACE=1 for xtrace.
EOF
}

check_dependencies() {
    local missing=()
    command_exists cargo || missing+=("cargo (rustup.rs)")
    command_exists rustup || missing+=("rustup")
    if [[ ${#missing[@]} -gt 0 ]]; then
        log "missing dependencies: ${missing[*]}"
        exit 1
    fi
}

install_deps() {
    log "checking toolchains"
    # Embedded (riscv32 + build-std) needs nightly with rust-src
    if ! rustup toolchain list | grep -q nightly; then
        log "installing nightly toolchain (required for edge embedded build)"
        rustup toolchain install nightly
    fi
    rustup component add rust-src --toolchain nightly >/dev/null 2>&1 || true
    log "fetching workspace dependencies"
    cargo fetch
    log "install OK"
}

lint() {
    log "cargo fmt --check"
    cargo fmt --all --check
    log "cargo clippy --workspace --all-targets -D warnings"
    cargo clippy --workspace --all-targets --target "$HOST_TARGET" -- -D warnings
    log "lint OK"
}

validate_and_build() {
    log "building workspace (host)"
    cargo build --workspace --target "$HOST_TARGET"
    log "checking edge embedded (riscv32imc, ESP32-C3)"
    (cd supervictor/edge && cargo +nightly check --features embedded)
    log "checking edge desktop"
    (cd supervictor/edge && cargo check --features desktop --target "$HOST_TARGET")
    log "build OK"
}

test_unit() {
    log "running workspace test suite"
    cargo test --workspace --target "$HOST_TARGET"
    log "unit OK"
}

test_integration() {
    if [[ -n "${SAM_LOCAL_URL:-}" ]]; then
        log "running SAM-local roundtrip tests against ${SAM_LOCAL_URL}"
        (cd supervictor/edge && cargo test --test sam_local_roundtrip --target "$HOST_TARGET")
    else
        log "SKIP sam-local tests (SAM_LOCAL_URL not set)"
    fi
    if [[ -n "${STAGING_URL:-}" ]]; then
        log "smoke: ${STAGING_URL}/health"
        curl -fsS --max-time 10 "${STAGING_URL}/health" >/dev/null
        log "staging healthy"
    else
        log "SKIP staging smoke (STAGING_URL not set)"
    fi
    log "integration OK"
}

publish() {
    log "deploying staging endpoint"
    exec "$REPO_ROOT/scripts/deploy-staging.sh"
}

check_dependencies

case "${1:-}" in
-h | --help | help)
    help_function
    ;;
-t | --test)
    lint
    validate_and_build
    test_unit
    test_integration
    ;;
install)
    install_deps
    ;;
lint)
    lint
    ;;
build)
    validate_and_build
    ;;
unit | test)
    test_unit
    ;;
integration)
    test_integration
    ;;
deploy)
    publish
    ;;
"")
    lint
    validate_and_build
    test_unit
    ;;
*)
    log "unknown command: $1"
    help_function
    exit 1
    ;;
esac
